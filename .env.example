# =============================================================================
# REQUIRED
# =============================================================================

# --- Chain -------------------------------------------------------------------
# Which chain the wallet uses: "sepolia" (staging) or "celo" (production).
# Defaults to celo when unset.
NEXT_PUBLIC_DEFAULT_CHAIN=

# --- Hats Protocol / Safe ----------------------------------------------------
# Staging (Sepolia):  leader hat 0x0000042c00010001000100000000000000000000000000000000000000000000
#                     safe       0x075293bBaEaC775095A8CCb0B1384bDe533E9920
# Production (Celo):  leader hat 0x0000001600010001000100000000000000000000000000000000000000000000
#                     safe       0xDa81Bd634045876AA6c7322Bff1Ca5044b5666E2
NEXT_PUBLIC_HATS_LEADER_ID=
NEXT_PUBLIC_HATS_LEADER_SAFE_ACCOUNT=

# --- RPC / wallet ------------------------------------------------------------
# Alchemy app with "Eth Sepolia" and "Celo Mainnet" enabled.
NEXT_PUBLIC_ALCHEMY_API_KEY=
# Reown (WalletConnect) project ID, used by the Silk connector.
NEXT_PUBLIC_WC_PROJECT_ID=
# WaaP environment: "staging" (default) or "production". Must match the mobile app's
# EXPO_PUBLIC_WAAP_ENVIRONMENT, or the same login gets a different wallet address.
NEXT_PUBLIC_WAAP_ENVIRONMENT=staging

# --- Database (server only) --------------------------------------------------
# Neon Postgres connection string. Apply migrations with `pnpm db:migrate`.
DATABASE_URL=

# --- Onboarding relayer (server only) ----------------------------------------
# Private key (0x + 64 hex) of the wallet that mints the leader hat and calls
# claimSignerFor on the HSG. It must wear an admin hat of the leader hat and
# hold gas on the default chain. Keep it secret: never prefix with NEXT_PUBLIC_.
RELAYER_PRIVATE_KEY=
# Hats Signer Gate the relayer calls claimSignerFor on.
# Staging: 0xB9Ec1bd7aD64E6f84BE7bF763c9774f4dd512517
# Production: 0xFD7E8D534971cE54136Bcc6Fb6089649F1307ebE
NEXT_PUBLIC_HSG_CONTRACT_ADDRESS=

# --- Stellar (disbursements to beneficiaries' Stellar accounts) ---------------
# Also part of every message a beneficiary signs, so signatures only work on this network
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Treasury (server only): holds the XLM, pays fees, sends disbursements
WALLET_SOURCE_PRIVATE_KEY=

# --- Disbursement limits (XLM; these are the defaults) ------------------------
DISBURSE_MAX_PER_TX=1
DISBURSE_MAX_PER_DAY=10
DISBURSE_STARTING_ALLOWANCE=100
# Kept back in the treasury for fees and the account minimum
DISBURSE_TREASURY_RESERVE=5

# --- Sessions (server only) --------------------------------------------------
# Signs the read-only session cookie (e.g. `openssl rand -hex 32`). Required.
SESSION_SECRET=

# --- Cron (server only) -----------------------------------------------------
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to /api/system/cleanup.
# Required: without it the cron refuses to run.
CRON_SECRET=

# --- API auth (server only) --------------------------------------------------
# Bearer token for /api/reservations/verify and POST /api/system/cleanup.
# Must match EXPO_PUBLIC_RELAYID_APP_API_TOKEN in the mobile app.
RELAYID_APP_API_TOKEN=""

# =============================================================================
# OPTIONAL
# =============================================================================

# Invite link lifetime in seconds. Default: 86400 (24h).
NEXT_PUBLIC_INVITE_TTL_SECONDS=

# Slack incoming webhook for onboarding success/failure and feedback messages.
# Without it, messages are skipped and an error is logged.
RELAYID_SLACK_NOTIFICATIONS_WEBHOOK_URL=

# Only used to build the Hats app link on /admin.
# Staging: 11155111 / 1068   Production: 42220 / 22
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_HATS_TREE_ID=
